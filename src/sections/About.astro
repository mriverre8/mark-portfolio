---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main>
    <section
        id="about"
        class="scroll-mt-20"
    >
        <div class="mx-auto my-24 w-full max-w-5xl space-y-2 px-4 sm:my-40">
            <img
                src="/profile.jpeg"
                alt="Mark Rivera"
                class="animate-zoom-in animate-duration-500 w-22 rounded-full object-cover"
            />
            <h1
                class="animate-fade-in-right animate-delay-100 animate-duration-500 text-ink text-4xl font-bold"
            >
                Mark Rivera
            </h1>
            <p
                class="animate-fade-in-right animate-delay-200 animate-duration-500 text-ink-muted text-xl"
            >
                {t('about.description')}
            </p>

            <div class="mt-4 flex flex-wrap gap-2 sm:items-center">
                <div
                    class="animate-fade-in-up animate-delay-300 animate-duration-500 border-edge bg-surface shadow-card inline-block w-max rounded-lg border px-4 py-2 sm:mx-0"
                >
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="relative flex h-2 w-2 sm:h-2.5 sm:w-2.5">
                            <span
                                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex h-2 w-2 rounded-full bg-green-600 sm:h-2.5 sm:w-2.5"
                            ></span>
                        </div>
                        <p class="text-ink text-sm font-medium">
                            {t('about.workingStatus')}
                        </p>
                    </div>
                </div>

                <a
                    href="https://github.com/mriverre8"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="animate-fade-in-up animate-delay-400 animate-duration-500 border-edge bg-surface text-ink shadow-card hover:border-accent-soft hover:text-accent rounded-md border px-4 py-2 font-semibold transition-colors"
                >
                    <img
                        src="/github-white.svg"
                        width="20"
                        class="hidden dark:block"
                        alt="GitHub"
                    />
                    <img
                        src="/github.svg"
                        width="20"
                        class="block dark:hidden"
                        alt="GitHub"
                    />
                </a>
                <a
                    href="https://www.linkedin.com/in/mark-rivera-ba33b2233/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="animate-fade-in-up animate-delay-500 animate-duration-500 border-edge bg-surface text-ink shadow-card hover:border-accent-soft hover:text-accent rounded-md border px-4 py-2 font-semibold transition-colors"
                >
                    <img
                        src="/linkedin.webp"
                        width="22"
                        class="hidden dark:block"
                        alt="LinkedIn"
                    />
                    <img
                        src="/linkedin-black.webp"
                        width="22"
                        class="block dark:hidden"
                        alt="LinkedIn"
                    />
                </a>
                <a
                    href="mailto:rivemark00@gmail.com"
                    class="animate-fade-in-up animate-delay-600 animate-duration-500 border-edge bg-surface text-ink shadow-card hover:border-accent-soft hover:text-accent flex items-center gap-2 rounded-md border px-4 py-2 font-semibold transition-colors sm:text-sm"
                >
                    <img
                        src="/mail.svg"
                        width="20"
                        class="dark:invert"
                        alt="Email"
                    />
                </a>
            </div>
        </div>
    </section>
</main>
