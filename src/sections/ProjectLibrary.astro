---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getProjects } from '../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = getProjects(lang);
---

<main>
    <section id="projects">
        <div class="mx-auto my-24 w-full max-w-5xl px-4 sm:my-20">
            <h2 class="text-ink mb-5 text-3xl font-semibold">
                {t('projects.library')}
            </h2>

            <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-10">
                {
                    projects.map((project, index) => (
                        <article
                            class="animate-pulse-fade-in border-edge bg-surface shadow-card hover:border-accent-soft hover:shadow-card-hover flex flex-col overflow-hidden rounded-2xl border transition-[border-color,box-shadow] duration-300"
                            style={`animation-delay: ${index * 100}ms;`}
                        >
                            <div class="flex flex-1 flex-col justify-between p-6">
                                <div>
                                    <div class="flex">
                                        <h3 class="text-ink flex-[9] text-2xl font-bold">
                                            {project.name}
                                        </h3>
                                        {project.featured && (
                                            <div class="mt-1.5 flex flex-[1] items-start justify-center">
                                                <img
                                                    src="/star.svg"
                                                    alt="Star"
                                                />
                                            </div>
                                        )}
                                    </div>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        {project.stack.map((tech) => (
                                            <span class="bg-badge text-badge-ink rounded-full px-3 py-1 text-xs font-medium">
                                                {tech}
                                            </span>
                                        ))}
                                    </div>
                                    <p class="text-ink-muted mt-4 text-sm leading-relaxed">
                                        {project.description}
                                    </p>
                                </div>

                                <div class="mt-6 flex flex-wrap gap-3">
                                    {project.github && (
                                        <a
                                            href={project.github}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="border-edge bg-surface-soft text-ink hover:border-accent hover:text-accent flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
                                        >
                                            <img
                                                src="/github-white.svg"
                                                width="18"
                                                class="hidden dark:block"
                                                alt="GitHub"
                                            />
                                            <img
                                                src="/github.svg"
                                                width="18"
                                                class="block dark:hidden"
                                                alt="GitHub"
                                            />
                                            {t('projects.repo')}
                                        </a>
                                    )}
                                    {project.deploy && (
                                        <a
                                            href={project.deploy}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="border-edge bg-surface-soft text-ink hover:border-accent hover:text-accent flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
                                        >
                                            <img
                                                src="/external-link.svg"
                                                width="18"
                                                class="dark:invert"
                                                alt="Visitar"
                                            />
                                            {t('projects.visit')}
                                        </a>
                                    )}
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
            <div class="text-center">
                <a
                    href={`/${lang}/#projects`}
                    class="border-edge bg-surface text-ink shadow-card hover:border-accent-soft hover:text-accent mt-12 inline-block items-center justify-center rounded-lg border py-2 pr-4 pl-2 text-sm font-medium transition-colors"
                >
                    <img
                        src="/chevron-left.svg"
                        width="18"
                        class="inline-block dark:invert"
                        alt="Ver"
                    />
                    <p class="inline-block">{t('projects.back')}</p>
                </a>
            </div>
        </div>
    </section>
</main>
