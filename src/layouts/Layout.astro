---
import { getLangFromUrl, getLocalizedPathname } from '../i18n/utils';
import { languages, defaultLang, ogLocales } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Same page in every language, so search engines treat them as one document.
const alternates = Object.keys(languages).map((code) => ({
    code,
    href: new URL(getLocalizedPathname(Astro.url.pathname, code), Astro.site)
        .href,
}));
const xDefault = alternates.find(({ code }) => code === defaultLang)!.href;
---

<!doctype html>
<html
    lang={lang}
    class=""
>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />

        <link
            rel="shortcut icon"
            href="/favicon.ico"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta
            name="apple-mobile-web-app-title"
            content="Mark Rivera"
        />
        <link
            rel="manifest"
            href="/site.webmanifest"
        />
        <title>{title}</title>
        <meta
            name="description"
            content={description}
        />
        <link
            rel="canonical"
            href={canonical}
        />
        {
            alternates.map(({ code, href }) => (
                <link
                    rel="alternate"
                    hreflang={code}
                    href={href}
                />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={xDefault}
        />
        <meta
            property="og:type"
            content="website"
        />
        <meta
            property="og:url"
            content={canonical}
        />
        <meta
            property="og:title"
            content={title}
        />
        <meta
            property="og:description"
            content={description}
        />
        <meta
            property="og:locale"
            content={ogLocales[lang]}
        />
        {
            alternates
                .filter(({ code }) => code !== lang)
                .map(({ code }) => (
                    <meta
                        property="og:locale:alternate"
                        content={ogLocales[code as keyof typeof ogLocales]}
                    />
                ))
        }
        <meta
            property="og:image"
            content={new URL('/profile.jpeg', Astro.site).href}
        />
        <meta
            name="twitter:card"
            content="summary"
        />
        <meta
            name="keywords"
            content="Mark Portfolio"
        />
        <meta
            name="author"
            content="Mark Rivera"
        />
        <meta
            name="robots"
            content="index, follow"
        />
        <meta
            name="googlebot"
            content="index, follow"
        />
        <meta
            name="bingbot"
            content="index, follow"
        />
        <meta
            name="yandexbot"
            content="index, follow"
        />

        <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
        <script is:inline>
            if (
                localStorage.theme === 'dark' ||
                (!('theme' in localStorage) &&
                    window.matchMedia('(prefers-color-scheme: dark)').matches)
            ) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        </script>
        <script is:inline>
            const mediaQuery = window.matchMedia(
                '(prefers-color-scheme: dark)'
            );
            mediaQuery.addEventListener('change', (e) => {
                if (!localStorage.getItem('theme')) {
                    if (e.matches) {
                        document.documentElement.classList.add('dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                    }
                }
            });
        </script>
    </head>

    <body>
        <div
            id="background-gradient"
            class="min-h-screen w-full"
        >
            <slot />
        </div>
    </body>
</html>

<style is:global>
    @import 'tailwindcss';
    @import 'tailwind-animations';

    @custom-variant dark (&:where(.dark, .dark *));
    :root {
        --palette-page: #eff3f9;
        --palette-page-tint: rgba(96, 165, 250, 0.3);
        --palette-page-haze: #f6f9fd;
        --palette-surface: #ffffff;
        --palette-surface-soft: #f4f7fc;
        --palette-edge: #dde4ef;
        --palette-edge-strong: #b9c6db;
        --palette-accent: #2563eb;
        --palette-accent-soft: #93b4f7;
        --palette-badge: #e8effc;
        --palette-badge-ink: #1d4ed8;
        --palette-ink: #101827;
        --palette-ink-muted: #4a5567;
        --palette-shadow-card:
            0 1px 2px rgba(16, 24, 39, 0.05),
            0 10px 26px -16px rgba(16, 24, 39, 0.28);
        --palette-shadow-card-hover:
            0 1px 2px rgba(16, 24, 39, 0.06),
            0 18px 38px -18px rgba(37, 99, 235, 0.35);
    }

    .dark {
        --palette-page: #0f1115;
        --palette-page-tint: rgba(37, 99, 235, 0.28);
        --palette-page-haze: #121722;
        --palette-surface: #15181f;
        --palette-surface-soft: #1c202a;
        --palette-edge: #272d38;
        --palette-edge-strong: #3b4453;
        --palette-accent: #60a5fa;
        --palette-accent-soft: #3b82f6;
        --palette-badge: #1b263c;
        --palette-badge-ink: #93b8fb;
        --palette-ink: #edf1f7;
        --palette-ink-muted: #9aa5b8;
        --palette-shadow-card:
            0 1px 2px rgba(0, 0, 0, 0.4), 0 12px 30px -18px rgba(0, 0, 0, 0.8);
        --palette-shadow-card-hover:
            0 1px 2px rgba(0, 0, 0, 0.4),
            0 18px 38px -18px rgba(37, 99, 235, 0.45);
    }

    @theme inline {
        --color-page: var(--palette-page);
        --color-surface: var(--palette-surface);
        --color-surface-soft: var(--palette-surface-soft);
        --color-edge: var(--palette-edge);
        --color-edge-strong: var(--palette-edge-strong);
        --color-accent: var(--palette-accent);
        --color-accent-soft: var(--palette-accent-soft);
        --color-badge: var(--palette-badge);
        --color-badge-ink: var(--palette-badge-ink);
        --color-ink: var(--palette-ink);
        --color-ink-muted: var(--palette-ink-muted);

        --shadow-card: var(--palette-shadow-card);
        --shadow-card-hover: var(--palette-shadow-card-hover);
    }

    body {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.83em;
    }
</style>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        scroll-behavior: smooth;
    }

    body {
        background: var(--palette-page);
    }

    #background-gradient {
        background: radial-gradient(
            circle at top center,
            var(--palette-page-tint) 0%,
            var(--palette-page-haze) 45%,
            var(--palette-page) 80%
        );
    }
</style>
